# ==============================================================================
# HỆ THỐNG LAB FITNESS API - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Sao chép file này thành .env và điều chỉnh theo môi trường của bạn:
#   cp .env.example .env (Linux/macOS) hoặc copy .env.example .env (Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Configuration
# ------------------------------------------------------------------------------
# Khi chạy local kết nối container: mongodb://admin:123456@localhost:27017/fitness_score?authSource=admin
# Khi chạy backend bên trong Docker: mongodb://admin:123456@mongodb:27017/fitness_score?authSource=admin
MONGODB_URI=mongodb://admin:123456@localhost:27017/fitness_score?authSource=admin
MONGODB_DB=fitness_score

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Security
# ------------------------------------------------------------------------------
SECRET_KEY=a8f12d9d8b4f5f3f4e7d81e4a2f9d8a3fbd7c23ac4e6b5e13e7d95b0a1e6d8c9
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. Redis Cache & Event Bus
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=optivisionlab
REDIS_DECODE_RESPONSES=True
REDIS_NOTIFY_EVENTS=KEA

# ------------------------------------------------------------------------------
# 4. MinIO S3 Object Storage
# ------------------------------------------------------------------------------
# Khi chạy local: localhost:9000
# Khi chạy trong Docker network: minio:9000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_NAME=videos
MINIO_SECURE=False

# ------------------------------------------------------------------------------
# 5. Kafka Message Broker
# ------------------------------------------------------------------------------
# Khi client chạy ngoài Docker (local app): localhost:9092
# Khi client chạy trong Docker network: kafka:9093
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_GRADING_JOBS=video-grading-jobs
KAFKA_TOPIC_GRADING_RESULTS=video-grading-results
KAFKA_TOPIC_GRADING_DLQ=video-grading-dlq
KAFKA_CONSUMER_GROUP_BACKEND=backend-result-consumer
KAFKA_CONSUMER_GROUP_AI=ai-grading-worker

# ------------------------------------------------------------------------------
# 6. Service & Security Keys
# ------------------------------------------------------------------------------
AI_API_KEY=internal-ai-worker-secret-key
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
