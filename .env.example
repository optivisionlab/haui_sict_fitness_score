# Copy to .env and replace every placeholder before starting the stack.
# Mongo passwords must use URI-safe alphanumeric characters.
MONGO_ROOT_USERNAME=fitness_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_long_alphanumeric_password
MONGODB_DB=fitness_score

REDIS_PASSWORD=CHANGE_ME_long_random_password

MINIO_ROOT_USER=fitness_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_long_random_password
MINIO_BUCKET_NAME=videos
MINIO_PUBLIC_ENDPOINT=localhost:9000

FRONTEND_PORT=4200
BACKEND_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

SECRET_KEY=CHANGE_ME_long_random_signing_key
AI_API_KEY=CHANGE_ME_long_random_internal_api_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200